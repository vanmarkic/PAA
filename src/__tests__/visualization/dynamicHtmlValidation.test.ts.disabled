/**
 * Dynamic HTML Validation Tests
 * Tests the structure and functionality of machines-dynamic.html
 *
 * @jest-environment jsdom
 * NOTE: These tests are temporarily skipped as they require the full Astro build
 * which is not available during the test phase of CI/CD.
 */

import * as fs from 'fs';
import * as path from 'path';
import { JSDOM } from 'jsdom';

describe.skip('Dynamic Visualization HTML Page', () => {
  const htmlPath = path.resolve(__dirname, '../../../docs/machines-dynamic.html');
  let dom: JSDOM;
  let document: Document;
  let window: Window & typeof globalThis;

  beforeEach(() => {
    const html = fs.readFileSync(htmlPath, 'utf-8');
    dom = new JSDOM(html, {
      runScripts: 'dangerously',
      resources: 'usable',
      url: 'http://localhost',
    });
    document = dom.window.document;
    window = dom.window as any;
  });

  afterEach(() => {
    dom.window.close();
  });

  describe('HTML Structure', () => {
    test('should have proper document structure', () => {
      expect(document.doctype).toBeTruthy();
      expect(document.documentElement.lang).toBe('en');
      expect(document.querySelector('meta[charset="UTF-8"]')).toBeTruthy();
      expect(document.querySelector('meta[name="viewport"]')).toBeTruthy();
    });

    test('should have correct page title', () => {
      expect(document.title).toContain('PAA');
      expect(document.title).toContain('State Machines');
      expect(document.title).toContain('Dynamic');
    });

    test('should include Mermaid library from CDN', () => {
      const scripts = Array.from(document.querySelectorAll('script'));
      const mermaidScript = scripts.find(s =>
        s.textContent?.includes('mermaid') ||
        s.src?.includes('mermaid')
      );

      expect(mermaidScript).toBeTruthy();
    });

    test('should have header with title', () => {
      const header = document.querySelector('header');
      expect(header).toBeTruthy();

      const title = header?.querySelector('h1');
      expect(title?.textContent).toContain('PAA');
      expect(title?.textContent).toContain('State Machines');
    });
  });

  describe('Search and Filter Controls', () => {
    test('should have search input', () => {
      const searchInput = document.getElementById('search') as HTMLInputElement;
      expect(searchInput).toBeTruthy();
      expect(searchInput.tagName).toBe('INPUT');
      expect(searchInput.type).toBe('text');
      expect(searchInput.placeholder).toContain('Rechercher');
    });

    test('should have filters container', () => {
      const filters = document.getElementById('filters');
      expect(filters).toBeTruthy();
      expect(filters?.classList.contains('filters')).toBe(true);
    });

    test('should have "Toutes" filter button by default', () => {
      const allButton = document.querySelector('.filter-btn[data-category="all"]');
      expect(allButton).toBeTruthy();
      expect(allButton?.textContent).toContain('Toutes');
      expect(allButton?.classList.contains('active')).toBe(true);
    });
  });

  describe('Statistics Display', () => {
    test('should have statistics container', () => {
      const stats = document.getElementById('stats');
      expect(stats).toBeTruthy();
      expect(stats?.classList.contains('stats')).toBe(true);
    });
  });

  describe('Machines Container', () => {
    test('should have machines grid container', () => {
      const container = document.getElementById('machines-container');
      expect(container).toBeTruthy();
      expect(container?.classList.contains('machines-grid')).toBe(true);
    });

    test('should have loading indicator', () => {
      const loading = document.getElementById('loading');
      expect(loading).toBeTruthy();
      expect(loading?.textContent).toContain('Chargement');
    });

    test('should have error container (hidden by default)', () => {
      // Read the HTML source to check the initial state before scripts run
      const html = fs.readFileSync(htmlPath, 'utf-8');
      expect(html).toMatch(/<div id="error"[^>]*style="display:\s*none;"/);
    });
  });

  describe('JavaScript Functions', () => {
    test('should have loadMachines function defined', () => {
      // Attendre que le script soit chargé
      expect(typeof (window as any).loadMachines).toBe('function');
    });

    test('should have filterByCategory function defined', () => {
      expect(typeof (window as any).filterByCategory).toBe('function');
    });

    test('should have displayMachines function defined', () => {
      expect(typeof (window as any).displayMachines).toBe('function');
    });

    test('should have createMachineCard function defined', () => {
      expect(typeof (window as any).createMachineCard).toBe('function');
    });

    test('should have generateMermaidDiagram function defined', () => {
      expect(typeof (window as any).generateMermaidDiagram).toBe('function');
    });
  });

  describe('Styling', () => {
    test('should have responsive design styles', () => {
      const styles = document.querySelector('style');
      expect(styles?.textContent).toContain('@media (max-width: 768px)');
    });

    test('should have gradient background styling', () => {
      const styles = document.querySelector('style');
      expect(styles?.textContent).toContain('linear-gradient');
      expect(styles?.textContent).toContain('#667eea');
      expect(styles?.textContent).toContain('#764ba2');
    });

    test('should have card-based layout styles', () => {
      const styles = document.querySelector('style');
      expect(styles?.textContent).toContain('.machine-card');
      expect(styles?.textContent).toContain('.machine-title');
      expect(styles?.textContent).toContain('.machine-category');
    });

    test('should have search bar styling', () => {
      const styles = document.querySelector('style');
      expect(styles?.textContent).toContain('.search-bar');
    });

    test('should have filter button styling', () => {
      const styles = document.querySelector('style');
      expect(styles?.textContent).toContain('.filter-btn');
      expect(styles?.textContent).toContain('.filter-btn.active');
    });
  });

  describe('Data Loading Logic', () => {
    test('should fetch machines-metadata.json', () => {
      const scriptContent = document.querySelector('script:not([type])')?.textContent || '';

      expect(scriptContent).toContain('machines-metadata.json');
      expect(scriptContent).toContain('fetch');
    });

    test('should handle fetch errors gracefully', () => {
      const scriptContent = document.querySelector('script:not([type])')?.textContent || '';

      expect(scriptContent).toContain('try');
      expect(scriptContent).toContain('catch');
      expect(scriptContent).toContain('error');
    });

    test('should update loading state', () => {
      const scriptContent = document.querySelector('script:not([type])')?.textContent || '';

      expect(scriptContent).toContain('loading');
      expect(scriptContent).toContain('display');
      expect(scriptContent).toContain('none');
    });
  });

  describe('Machine Card Generation', () => {
    test('should generate machine cards with correct structure', () => {
      const mockMachine = {
        id: 'testMachine',
        name: 'Test Machine',
        category: 'test',
        description: 'A test machine',
        states: ['idle', 'running', 'done'],
        events: ['START', 'STOP'],
        initial: 'idle',
      };

      // Simuler la fonction createMachineCard
      const card = createMachineCardHTML(mockMachine);

      expect(card).toContain('machine-card');
      expect(card).toContain('machine-title');
      expect(card).toContain('Test Machine');
      expect(card).toContain('machine-category');
      expect(card).toContain('test');
      expect(card).toContain('machine-description');
      expect(card).toContain('mermaid');
      expect(card).toContain('machine-stat');
    });
  });

  describe('Mermaid Diagram Generation', () => {
    test('should generate valid Mermaid syntax', () => {
      const mockMachine = {
        id: 'testMachine',
        name: 'Test Machine',
        category: 'test',
        description: 'A test machine',
        states: ['idle', 'running', 'done'],
        events: ['START', 'STOP'],
        initial: 'idle',
      };

      const diagram = generateTestMermaidDiagram(mockMachine);

      expect(diagram).toContain('stateDiagram-v2');
      expect(diagram).toContain('[*] --> idle');
      expect(diagram).toContain('idle --> running');
      expect(diagram).toContain('idle --> done');
    });

    test('should handle machines with single state', () => {
      const mockMachine = {
        id: 'singleState',
        name: 'Single State',
        category: 'test',
        description: 'Single state machine',
        states: ['only'],
        events: [],
        initial: 'only',
      };

      const diagram = generateTestMermaidDiagram(mockMachine);

      expect(diagram).toContain('stateDiagram-v2');
      expect(diagram).toContain('[*] --> only');
      // Ne devrait pas avoir de self-transition
      expect(diagram.match(/only --> only/g)).toBeFalsy();
    });

    test('should not produce invalid Mermaid syntax', () => {
      const mockMachine = {
        id: 'testMachine',
        name: 'Test Machine',
        category: 'test',
        description: 'A test machine',
        states: ['state1', 'state2'],
        events: ['EVENT1'],
        initial: 'state1',
      };

      const diagram = generateTestMermaidDiagram(mockMachine);

      // Vérifier qu'il n'y a pas de undefined ou null
      expect(diagram).not.toContain('undefined');
      expect(diagram).not.toContain('null');
      expect(diagram).not.toContain('NaN');

      // Vérifier qu'il n'y a pas de lignes vides multiples
      expect(diagram).not.toMatch(/\n\n\n+/);
    });
  });

  describe('Accessibility', () => {
    test('should have proper heading hierarchy', () => {
      const h1 = document.querySelector('h1');
      expect(h1).toBeTruthy();

      // Les cartes de machines auront des h3
      const scriptContent = document.querySelector('script:not([type])')?.textContent || '';
      expect(scriptContent).toContain('machine-title'); // h3 dans le template
    });

    test('should have accessible form controls', () => {
      const searchInput = document.getElementById('search') as HTMLInputElement;
      expect(searchInput.placeholder).toBeTruthy(); // Devrait avoir un placeholder descriptif

      const buttons = document.querySelectorAll('button');
      buttons.forEach(btn => {
        expect(btn.textContent?.trim()).toBeTruthy(); // Tous les boutons devraient avoir du texte
      });
    });
  });

  describe('Performance Considerations', () => {
    test('should use event delegation for filters', () => {
      const scriptContent = document.querySelector('script:not([type])')?.textContent || '';

      // Devrait avoir des onclick individuels sur les boutons de filtre
      expect(scriptContent).toContain('onclick');
      expect(scriptContent).toContain('filterByCategory');
    });

    test('should lazy-render Mermaid diagrams', () => {
      const scriptContent = document.querySelector('script:not([type])')?.textContent || '';

      // Devrait appeler mermaid.run() seulement après avoir inséré le HTML
      expect(scriptContent).toContain('mermaid.run');
      expect(scriptContent).toContain('displayMachines');
    });
  });
});

// Helper functions for testing
function createMachineCardHTML(machine: any): string {
  const diagram = generateTestMermaidDiagram(machine);

  return `
    <div class="machine-card">
        <div class="machine-header">
            <h3 class="machine-title">${machine.name}</h3>
            <span class="machine-category">${machine.category}</span>
            <p class="machine-description">${machine.description || 'No description available'}</p>
        </div>

        <div class="machine-stats">
            <div class="machine-stat">
                <div class="machine-stat-value">${machine.states.length}</div>
                <div class="machine-stat-label">States</div>
            </div>
            <div class="machine-stat">
                <div class="machine-stat-value">${machine.events.length}</div>
                <div class="machine-stat-label">Events</div>
            </div>
        </div>

        <div class="mermaid">
${diagram}
        </div>
    </div>
  `;
}

function generateTestMermaidDiagram(machine: any): string {
  let diagram = 'stateDiagram-v2\n';
  diagram += `    [*] --> ${machine.initial}\n`;

  machine.states.forEach((state: string) => {
    if (state !== machine.initial) {
      diagram += `    ${machine.initial} --> ${state}\n`;
    }
  });

  return diagram;
}
