# PAA AI Layer — Environment Variables
# Copy to .env and fill in values for local development.
# All keys are optional: the embedder, reranker, and generator each fall back
# to a stub when their key is missing, so the pipeline runs end-to-end offline.

# ---------------------------------------------------------------------------
# Generation (Claude is recommended)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=anthropic                       # anthropic | openai | stub
LLM_MODEL=claude-sonnet-4-20250514

# ---------------------------------------------------------------------------
# Embeddings — pick ONE provider (auto picks the first available below).
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=auto                      # voyage | cohere | openai | local | stub | auto

# Recommended: Voyage AI (Anthropic-recommended partner, multilingual, $0.02–$0.12/MTok).
# Sign up: https://www.voyageai.com/
VOYAGE_API_KEY=

# Alt 1: Cohere (multilingual, $0.12/MTok). Already needed if using their reranker.
COHERE_API_KEY=

# Alt 2: OpenAI (text-embedding-3-small, $0.02/MTok). Truncated to 1024 dim.
OPENAI_API_KEY=

# Alt 3: Local — runs on CPU/GPU, no key. Install with: uv sync --extra local
# Default model: BAAI/bge-m3 (1024 dim, multilingual, ~2GB download).
# Alternatives: intfloat/multilingual-e5-large, paraphrase-multilingual-mpnet-base-v2
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# Override the picked model and dimension if needed:
# EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIM=1024

# ---------------------------------------------------------------------------
# Reranker — Cohere or Voyage. Falls back to passthrough (no rerank) without key.
# ---------------------------------------------------------------------------
RERANKER_PROVIDER=auto                       # cohere | voyage | passthrough | auto
RERANKER_MODEL=rerank-v3.5

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Local Docker uses pgvector/pgvector:pg16. Deployed: point at Supabase or Neon
# (free tiers ship pgvector — Render's free Postgres does NOT).
DATABASE_URL=postgresql://paa:paa_dev@localhost:5432/paa
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------
RETRIEVER_TOP_K=20
RERANKER_TOP_K=5
RRF_K=60
