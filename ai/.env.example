# PAA AI Layer — Environment Variables
# Copy to .env and fill in values for local development.

# LLM providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
COHERE_API_KEY=

# Models
LLM_PROVIDER=anthropic                       # anthropic | openai
LLM_MODEL=claude-sonnet-4-20250514
EMBEDDING_MODEL=text-embedding-3-small
RERANKER_MODEL=rerank-v3.5

# Database (pgvector on PostgreSQL 16)
DATABASE_URL=postgresql://paa:paa_dev@localhost:5432/paa

# Redis (caching, rate limiting)
REDIS_URL=redis://localhost:6379/0

# API server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Retrieval tuning
RETRIEVER_TOP_K=20
RERANKER_TOP_K=5
RRF_K=60
