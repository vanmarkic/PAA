---
import MainLayout from '../layouts/Layout.astro';
import { loadMachinesMetadata } from '../lib/machines';
import { getUrl } from '../lib/utils';

// Load machines data at build time
const metadata = await loadMachinesMetadata();

// Group benefits by category
const benefitCategories = [
  {
    id: 'social',
    name: 'Prestations Sociales',
    icon: 'users',
    description: 'Aides sociales, allocations et soutien aux personnes en difficulté',
    workflows: metadata.machines.filter((m: any) => ['social', 'family', 'handicap'].includes(m.category))
  },
  {
    id: 'housing',
    name: 'Logement',
    icon: 'home',
    description: 'Aides au logement, primes énergie et rénovation',
    workflows: metadata.machines.filter((m: any) => ['housing', 'energy'].includes(m.category))
  },
  {
    id: 'employment',
    name: 'Emploi & Formation',
    icon: 'briefcase',
    description: 'Aides à l\'emploi, formations et soutien aux entreprises',
    workflows: metadata.machines.filter((m: any) => ['selfemployed', 'education'].includes(m.category))
  },
  {
    id: 'health',
    name: 'Santé',
    icon: 'heart',
    description: 'Remboursements santé, aides médicales et soutien aux soins',
    workflows: metadata.machines.filter((m: any) => m.category === 'health')
  },
  {
    id: 'pension',
    name: 'Pension & Retraite',
    icon: 'clock',
    description: 'Pensions, allocations de retraite et avantages seniors',
    workflows: metadata.machines.filter((m: any) => m.category === 'pension')
  },
  {
    id: 'fiscal',
    name: 'Avantages Fiscaux',
    icon: 'calculator',
    description: 'Réductions d\'impôts, déductions et avantages fiscaux',
    workflows: metadata.machines.filter((m: any) => m.category === 'fiscal')
  }
];

// Featured benefits
const featuredBenefits = [
  {
    title: 'Revenu d\'Intégration Sociale (RIS)',
    description: 'Aide financière mensuelle pour les personnes sans ressources suffisantes',
    amount: 'Jusqu\'à 1.450€/mois',
    category: 'social'
  },
  {
    title: 'Allocations Familiales',
    description: 'Aide mensuelle pour chaque enfant à charge',
    amount: '95-368€/enfant',
    category: 'family'
  },
  {
    title: 'Prime Énergie',
    description: 'Aide pour réduire la consommation énergétique du logement',
    amount: 'Jusqu\'à 7.000€',
    category: 'energy'
  }
];
---

<MainLayout title="Guide des Prestations - PAA" description="Guide complet des prestations sociales belges">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Guide des Prestations Sociales</h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Découvrez toutes les aides et prestations disponibles en Belgique.
        Trouvez rapidement les soutiens auxquels vous avez droit.
      </p>
    </div>

    <!-- Quick Search -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-12">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Recherche Rapide</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href={getUrl('wizard')} class="p-4 bg-purple-50 text-purple-700 rounded-lg hover:bg-purple-100 transition-colors text-center">
          <svg class="w-8 h-8 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <div class="font-medium">Test d'Éligibilité</div>
          <div class="text-sm mt-1">Vérifiez vos droits</div>
        </a>
        <a href="#calculator" class="p-4 bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition-colors text-center">
          <svg class="w-8 h-8 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
          <div class="font-medium">Calculateur</div>
          <div class="text-sm mt-1">Estimez vos aides</div>
        </a>
        <a href={getUrl('comparison')} class="p-4 bg-green-50 text-green-700 rounded-lg hover:bg-green-100 transition-colors text-center">
          <svg class="w-8 h-8 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          <div class="font-medium">Comparer</div>
          <div class="text-sm mt-1">Analysez les options</div>
        </a>
      </div>
    </div>

    <!-- Featured Benefits -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Prestations Principales</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredBenefits.map((benefit) => (
          <div class="bg-white rounded-lg border-2 border-purple-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">{benefit.title}</h3>
            <p class="text-gray-600 mb-4">{benefit.description}</p>
            <div class="flex items-center justify-between">
              <span class="text-2xl font-bold text-purple-600">{benefit.amount}</span>
              <a href={getUrl(`workflows?category=${benefit.category}`)} class="text-purple-600 hover:text-purple-700 font-medium">
                En savoir plus →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Categories Grid -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Catégories de Prestations</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefitCategories.map((category) => (
          <div class="bg-white rounded-lg border border-gray-200 p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-start mb-4">
              <div class="flex-shrink-0 w-12 h-12 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center">
                {category.icon === 'users' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                  </svg>
                )}
                {category.icon === 'home' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                  </svg>
                )}
                {category.icon === 'briefcase' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                )}
                {category.icon === 'heart' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                  </svg>
                )}
                {category.icon === 'clock' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                )}
                {category.icon === 'calculator' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                  </svg>
                )}
              </div>
              <div class="ml-4 flex-1">
                <h3 class="text-lg font-semibold text-gray-900 mb-2">{category.name}</h3>
                <p class="text-gray-600 text-sm mb-3">{category.description}</p>
                <div class="text-purple-600 font-medium">{category.workflows.length} workflows disponibles</div>
              </div>
            </div>
            <div class="border-t pt-4">
              <div class="space-y-2">
                {category.workflows.slice(0, 3).map((workflow: any) => (
                  <a href={getUrl(`workflows/${workflow.id}`)} class="block text-sm text-gray-700 hover:text-purple-600 transition-colors">
                    → {workflow.name}
                  </a>
                ))}
              </div>
              {category.workflows.length > 3 && (
                <a href={getUrl(`workflows?category=${category.id}`)} class="block mt-3 text-sm font-medium text-purple-600 hover:text-purple-700">
                  Voir tous ({category.workflows.length})
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Help Section -->
    <div class="bg-gradient-to-r from-blue-500 to-blue-700 rounded-xl p-8 text-white">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold mb-4">Besoin d'Aide Pour Faire Votre Demande?</h2>
        <p class="mb-6 text-blue-100">
          Nos conseillers sont là pour vous accompagner dans vos démarches. Prenez rendez-vous dans votre CPAS local ou utilisez notre assistant en ligne.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href={getUrl('wizard')} class="inline-block px-6 py-3 bg-white text-blue-600 font-semibold rounded-lg hover:bg-blue-50 transition-colors">
            Assistant en Ligne
          </a>
          <a href="https://www.belgium.be/fr/famille/aide_sociale/cpas" target="_blank" rel="noopener noreferrer" class="inline-block px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-800 transition-colors">
            Trouver un CPAS
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>