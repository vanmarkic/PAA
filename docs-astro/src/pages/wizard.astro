---
import MainLayout from '../layouts/Layout.astro';
import WorkflowWizard from '../components/WorkflowWizard.tsx';
import { loadMachinesMetadata } from '../lib/machines';
import { getUrl } from '../lib/utils';

// Load machines data at build time
const metadata = await loadMachinesMetadata();
---

<MainLayout title="Assistant de Recherche - PAA" description="Trouvez rapidement la prestation ou la procédure dont vous avez besoin">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Assistant de Recherche</h1>
      <p class="text-xl text-gray-600">
        Répondez à quelques questions pour trouver les prestations et procédures qui correspondent à votre situation.
      </p>
    </div>

    <!-- React Island for Interactive Wizard -->
    <WorkflowWizard machines={metadata.machines} baseUrl={getUrl('')} client:load />

    <!-- Static FAQ Section -->
    <div class="mt-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Questions Fréquentes</h2>
      <div class="space-y-4">
        <details class="bg-white rounded-lg border border-gray-200 p-6">
          <summary class="font-semibold text-gray-900 cursor-pointer">
            Comment savoir si j'ai droit à une prestation?
          </summary>
          <p class="mt-4 text-gray-600">
            L'éligibilité dépend de plusieurs facteurs : votre situation familiale, vos revenus, votre statut de résidence, etc.
            Utilisez notre assistant pour obtenir une première évaluation, mais consultez toujours votre CPAS pour une réponse définitive.
          </p>
        </details>

        <details class="bg-white rounded-lg border border-gray-200 p-6">
          <summary class="font-semibold text-gray-900 cursor-pointer">
            Combien de temps prend le traitement d'une demande?
          </summary>
          <p class="mt-4 text-gray-600">
            Les délais varient selon le type de prestation : de 30 jours pour le RIS à plusieurs mois pour certaines aides spécifiques.
            Chaque procédure indique le délai moyen de traitement.
          </p>
        </details>

        <details class="bg-white rounded-lg border border-gray-200 p-6">
          <summary class="font-semibold text-gray-900 cursor-pointer">
            Puis-je cumuler plusieurs prestations?
          </summary>
          <p class="mt-4 text-gray-600">
            Certaines prestations sont cumulables, d'autres non. Par exemple, vous ne pouvez pas recevoir le RIS et le chômage en même temps.
            Notre outil de comparaison peut vous aider à comprendre les compatibilités.
          </p>
        </details>

        <details class="bg-white rounded-lg border border-gray-200 p-6">
          <summary class="font-semibold text-gray-900 cursor-pointer">
            Où puis-je obtenir de l'aide pour ma demande?
          </summary>
          <p class="mt-4 text-gray-600">
            Votre CPAS local est le premier point de contact pour la plupart des prestations sociales.
            Des assistants sociaux peuvent vous accompagner gratuitement dans vos démarches.
          </p>
        </details>
      </div>
    </div>

    <!-- Contact CTA -->
    <div class="mt-12 bg-gradient-to-r from-purple-500 to-purple-700 rounded-xl p-8 text-center text-white">
      <h2 class="text-2xl font-bold mb-4">Besoin d'Aide Personnalisée?</h2>
      <p class="mb-6">
        Nos conseillers sont disponibles pour répondre à vos questions spécifiques.
      </p>
      <div class="flex justify-center gap-4">
        <a href="#contact" class="inline-block px-6 py-3 bg-white text-purple-600 font-semibold rounded-lg hover:bg-gray-100 transition-colors">
          Contacter un Conseiller
        </a>
        <a href={getUrl('benefits')} class="inline-block px-6 py-3 bg-purple-600 text-white font-semibold rounded-lg hover:bg-purple-800 transition-colors">
          Voir Toutes les Prestations
        </a>
      </div>
    </div>
  </div>
</MainLayout>