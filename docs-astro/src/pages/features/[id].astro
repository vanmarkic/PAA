---
import MainLayout from '../../layouts/Layout.astro';
import { loadFeaturesMetadata } from '../../lib/features';
import { getRelatedWorkflows, getRelatedRulesForFeature } from '../../lib/cross-references';

// Generate static paths for all features
export async function getStaticPaths() {
  const metadata = await loadFeaturesMetadata();
  const { features } = metadata;

  // Create categories map
  const categoriesMap: Record<string, any> = {};
  metadata.categories.forEach(cat => {
    categoriesMap[cat] = {
      name: cat.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
      count: features.filter(f => f.category === cat).length
    };
  });

  return features.map((feature) => ({
    params: { id: feature.id },
    props: { feature, allFeatures: features, categories: categoriesMap }
  }));
}

const { feature, allFeatures, categories } = Astro.props;

// Find related features (same category, different id)
const relatedFeatures = allFeatures
  .filter((f: any) => f.category === feature.category && f.id !== feature.id)
  .slice(0, 3);

// Get related workflows and rules using cross-references
const relatedWorkflows = await getRelatedWorkflows(feature.id);
const relatedRules = await getRelatedRulesForFeature(feature.id);

// Format step keyword for display
function getStepIcon(keyword: string) {
  switch (keyword) {
    case 'Given': return '🎯';
    case 'When': return '⚡';
    case 'Then': return '✅';
    case 'And': return '➕';
    case 'But': return '⚠️';
    default: return '•';
  }
}

function getStepColor(keyword: string) {
  switch (keyword) {
    case 'Given': return 'text-blue-600 bg-blue-50 border-blue-200';
    case 'When': return 'text-purple-600 bg-purple-50 border-purple-200';
    case 'Then': return 'text-green-600 bg-green-50 border-green-200';
    case 'And': return 'text-gray-600 bg-gray-50 border-gray-200';
    case 'But': return 'text-orange-600 bg-orange-50 border-orange-200';
    default: return 'text-gray-600 bg-gray-50 border-gray-200';
  }
}
---

<MainLayout
  title={`${feature.name} - Spécification Gherkin PAA`}
  description={feature.description || `Spécification comportementale BDD pour ${feature.name}`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="mb-8">
      <ol class="flex items-center space-x-2 text-sm text-gray-500">
        <li><a href="/" class="hover:text-gray-700">Accueil</a></li>
        <li>/</li>
        <li><a href="/features" class="hover:text-gray-700">Fonctionnalités</a></li>
        <li>/</li>
        <li><a href={`/features/category/${feature.category}`} class="hover:text-gray-700">
          {categories[feature.category]?.name}
        </a></li>
        <li>/</li>
        <li class="text-gray-900">{feature.name}</li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-start justify-between">
        <div class="flex-1">
          <h1 class="text-4xl font-bold text-gray-900 mb-4">{feature.name}</h1>
          {feature.description && (
            <p class="text-lg text-gray-600 mb-6">
              {feature.description}
            </p>
          )}

          <div class="flex flex-wrap gap-3 mb-6">
            <span class="inline-block px-4 py-2 bg-purple-100 text-purple-700 text-sm font-medium rounded-full">
              {categories[feature.category]?.name}
            </span>
            {feature.language && (
              <span class="inline-block px-4 py-2 bg-blue-100 text-blue-700 text-sm font-medium rounded-full">
                Langue: {feature.language.toUpperCase()}
              </span>
            )}
            {feature.version && (
              <span class="inline-block px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-full">
                Version {feature.version}
              </span>
            )}
          </div>

          {feature.tags && feature.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {feature.tags.map((tag: string) => (
                <span class="inline-block px-3 py-1 bg-gray-200 text-gray-700 text-xs font-mono rounded">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>

        <div class="flex gap-3 ml-4">
          <button onclick="window.print()" class="px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
            Imprimer
          </button>
          <a href={feature.file ? `/features/${feature.file}` : '#'} class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700">
            Voir fichier source
          </a>
        </div>
      </div>
    </div>

    <!-- Metadata Cards -->
    {(feature.legalBasis || feature.effectiveDate || feature.implementedBy) && (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        {feature.legalBasis && (
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <div class="flex items-start">
              <svg class="w-5 h-5 text-purple-500 mt-1 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path>
              </svg>
              <div>
                <div class="text-sm font-medium text-gray-500 mb-1">Base Légale</div>
                <div class="text-gray-900">{feature.legalBasis}</div>
                {feature.legalUrl && (
                  <a href={feature.legalUrl} target="_blank" class="text-sm text-purple-600 hover:text-purple-700 mt-2 inline-block">
                    Voir le texte officiel →
                  </a>
                )}
              </div>
            </div>
          </div>
        )}

        {feature.effectiveDate && (
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <div class="flex items-start">
              <svg class="w-5 h-5 text-blue-500 mt-1 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <div>
                <div class="text-sm font-medium text-gray-500 mb-1">Date d'Effet</div>
                <div class="text-gray-900">{feature.effectiveDate}</div>
              </div>
            </div>
          </div>
        )}

        {feature.implementedBy && (
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <div class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mt-1 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
              <div>
                <div class="text-sm font-medium text-gray-500 mb-1">Implémentation</div>
                <div class="text-gray-900 font-mono text-sm">{feature.implementedBy}</div>
              </div>
            </div>
          </div>
        )}
      </div>
    )}

    <!-- Background/Context -->
    {feature.background && feature.background.steps && feature.background.steps.length > 0 && (
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-12">
        <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
          <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Contexte
        </h2>
        <div class="space-y-2">
          {feature.background.steps.map((step: any) => (
            <div class="pl-4 text-gray-700">
              <span class="font-mono text-sm">{step.text || step}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Scenarios -->
    <div class="space-y-8 mb-12">
      <h2 class="text-2xl font-bold text-gray-900">Scénarios ({feature.scenarios?.length || 0})</h2>

      {(feature.scenarios || []).map((scenario: any, index: number) => (
        <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
          <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                <span class="flex-shrink-0 w-8 h-8 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center text-sm font-bold mr-3">
                  {index + 1}
                </span>
                {scenario.name}
              </h3>
              <span class={`px-3 py-1 text-xs font-medium rounded-full ${
                scenario.type === 'Scenario Outline'
                  ? 'bg-orange-100 text-orange-700'
                  : 'bg-green-100 text-green-700'
              }`}>
                {scenario.type}
              </span>
            </div>
          </div>

          <div class="p-6">
            <!-- Steps -->
            <div class="space-y-3 mb-6">
              {scenario.steps.map((step: any) => (
                <div class={`flex items-start p-3 rounded-lg border ${getStepColor(step.keyword)}`}>
                  <span class="flex-shrink-0 text-lg mr-3">{getStepIcon(step.keyword)}</span>
                  <div class="flex-1">
                    <span class="font-semibold text-sm uppercase tracking-wider mr-2">
                      {step.keyword}
                    </span>
                    <span class="text-gray-700">{step.text}</span>
                  </div>
                </div>
              ))}
            </div>

            <!-- Examples (for Scenario Outlines) -->
            {scenario.examples && scenario.examples.length > 0 && scenario.examples[0].headers && scenario.examples[0].headers.length > 0 && (
              <div class="mt-6">
                <h4 class="text-sm font-semibold text-gray-700 mb-3">Exemples:</h4>
                <div class="overflow-x-auto">
                  <table class="min-w-full divide-y divide-gray-200 border border-gray-200">
                    <thead class="bg-gray-50">
                      <tr>
                        {scenario.examples[0].headers.map((header: string) => (
                          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            {header}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      {scenario.examples[0].rows.map((row: any) => (
                        <tr>
                          {scenario.examples[0].headers.map((header: string) => (
                            <td class="px-4 py-2 text-sm text-gray-900 font-mono">
                              {row.values?.[header] || row[header] || ''}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Plain Language Explanation -->
    {feature.plainLanguage && (
      <div class="bg-purple-50 border border-purple-200 rounded-lg p-6 mb-12">
        <h2 class="text-xl font-semibold text-gray-900 mb-3 flex items-center">
          <svg class="w-5 h-5 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
          </svg>
          Explication en Langage Clair
        </h2>
        <p class="text-gray-700">{feature.plainLanguage}</p>
      </div>
    )}

    <!-- Related Workflows -->
    {relatedWorkflows.length > 0 && (
      <div class="mb-12">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">
          <span class="inline-flex items-center">
            <svg class="w-5 h-5 text-purple-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            Workflows Implémentant Cette Spécification
          </span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedWorkflows.slice(0, 4).map((workflow: any) => (
            <a href={`/workflows/${workflow.id}`} class="bg-white rounded-lg border border-gray-200 p-6 hover:border-purple-500 hover:shadow-lg transition-all">
              <div class="flex items-start justify-between mb-3">
                <h3 class="font-semibold text-gray-900">{workflow.name}</h3>
                <span class="px-2 py-1 bg-purple-100 text-purple-700 text-xs font-medium rounded">
                  Workflow
                </span>
              </div>
              <p class="text-gray-600 text-sm mb-3">
                {workflow.description || 'Workflow administratif'}
              </p>
              <div class="flex items-center text-sm text-gray-500">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
                Score: {workflow.matchScore}
              </div>
              {workflow.matchReasons && (
                <div class="mt-2 text-xs text-gray-400">
                  {workflow.matchReasons.slice(0, 2).join(' • ')}
                </div>
              )}
            </a>
          ))}
        </div>
        {relatedWorkflows.length > 4 && (
          <div class="mt-4 text-center">
            <a href="/workflows" class="text-sm text-purple-600 hover:text-purple-700">
              Voir tous les workflows →
            </a>
          </div>
        )}
      </div>
    )}

    <!-- Related Rules -->
    {relatedRules.length > 0 && (
      <div class="mb-12">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">
          <span class="inline-flex items-center">
            <svg class="w-5 h-5 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
            </svg>
            Règles Métier Associées
          </span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedRules.slice(0, 4).map((rule: any) => (
            <a href={`/rules/${rule.id}`} class="bg-white rounded-lg border border-gray-200 p-6 hover:border-blue-500 hover:shadow-lg transition-all">
              <div class="flex items-start justify-between mb-3">
                <h3 class="font-semibold text-gray-900">{rule.name}</h3>
                <span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-medium rounded">
                  Règle
                </span>
              </div>
              <p class="text-gray-600 text-sm mb-3">
                {rule.description || 'Règle de gestion'}
              </p>
              <div class="flex items-center text-sm text-gray-500">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                Score: {rule.matchScore}
              </div>
              {rule.matchReasons && (
                <div class="mt-2 text-xs text-gray-400">
                  {rule.matchReasons.slice(0, 2).join(' • ')}
                </div>
              )}
            </a>
          ))}
        </div>
        {relatedRules.length > 4 && (
          <div class="mt-4 text-center">
            <a href="/rules" class="text-sm text-blue-600 hover:text-blue-700">
              Voir toutes les règles →
            </a>
          </div>
        )}
      </div>
    )}

    <!-- Related Features -->
    {relatedFeatures.length > 0 && (
      <div class="mb-12">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">
          <span class="inline-flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            Fonctionnalités Connexes
          </span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedFeatures.map((related: any) => (
            <a href={`/features/${related.id}`} class="bg-white rounded-lg border border-gray-200 p-6 hover:border-green-500 hover:shadow-lg transition-all">
              <h3 class="font-semibold text-gray-900 mb-2">{related.name}</h3>
              <p class="text-gray-600 text-sm mb-3">
                {related.description || 'Spécification comportementale BDD'}
              </p>
              <div class="flex items-center justify-between text-sm text-gray-500">
                <span>{related.scenarios?.length || 0} scénarios</span>
                <span class="text-green-600">Voir →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Gherkin Syntax Reference -->
    <div class="mt-12 bg-gray-100 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Référence Syntaxe Gherkin</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
        <div class="flex items-start">
          <span class="text-blue-600 mr-2">🎯</span>
          <div>
            <span class="font-semibold">Given (Étant donné)</span>
            <p class="text-gray-600">Décrit le contexte initial</p>
          </div>
        </div>
        <div class="flex items-start">
          <span class="text-purple-600 mr-2">⚡</span>
          <div>
            <span class="font-semibold">When (Quand)</span>
            <p class="text-gray-600">L'action ou événement déclencheur</p>
          </div>
        </div>
        <div class="flex items-start">
          <span class="text-green-600 mr-2">✅</span>
          <div>
            <span class="font-semibold">Then (Alors)</span>
            <p class="text-gray-600">Le résultat attendu</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>