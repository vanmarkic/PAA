---
import { loadFeaturesMetadata } from '../../lib/features';
import { getRelatedRulesForFeature } from '../../lib/cross-references';
import { getUrl } from '../../lib/utils';

// Generate static paths for all features
export async function getStaticPaths() {
  const metadata = await loadFeaturesMetadata();
  const { features } = metadata;

  return await Promise.all(features.map(async (feature) => {
    // Find the most closely related rule
    const relatedRules = await getRelatedRulesForFeature(feature.id);
    const primaryRule = relatedRules && relatedRules.length > 0 ? relatedRules[0] : null;

    return {
      params: { id: feature.id },
      props: { feature, primaryRule }
    };
  }));
}

const { feature, primaryRule } = Astro.props;

// If we have a primary rule, redirect to it
// Otherwise, redirect to the features list
const redirectUrl = primaryRule
  ? getUrl(`rules/${primaryRule.id}`)
  : getUrl('features');
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
    <title>Redirection...</title>
    <script define:vars={{ redirectUrl }}>
      window.location.href = redirectUrl;
    </script>
  </head>
  <body>
    <div style="text-align: center; padding: 50px; font-family: system-ui, -apple-system, sans-serif;">
      <h1>Redirection en cours...</h1>
      <p>La fonctionnalité "{feature.name}" a été intégrée à la page de règle correspondante.</p>
      <p>Si vous n'êtes pas redirigé automatiquement, <a href={redirectUrl}>cliquez ici</a>.</p>
    </div>
  </body>
</html>