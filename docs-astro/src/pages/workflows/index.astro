---
import MainLayout from '../../layouts/Layout.astro';
import { loadMachinesMetadata } from '../../lib/machines';
import { getUrl } from '../../lib/utils';

// Load machines data at build time
const metadata = await loadMachinesMetadata();
const { machines, categories } = metadata;

// Group all machines by category for display
const machinesByCategory = machines.reduce((acc: any, machine: any) => {
  if (!acc[machine.category]) {
    acc[machine.category] = [];
  }
  acc[machine.category].push(machine);
  return acc;
}, {});

// Category counts for filter buttons
const categoryCounts = categories.reduce((acc: any, cat: string) => {
  acc[cat] = machines.filter((m: any) => m.category === cat).length;
  return acc;
}, {} as Record<string, number>);
---

<MainLayout
  title="Toutes les Procédures - PAA"
  description="Liste complète des procédures administratives belges"
  breadcrumbs={[{ label: 'Procédures' }]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 id="page-title" class="text-4xl font-bold text-gray-900 mb-4">
        Toutes les Procédures
      </h1>
      <p class="text-xl text-gray-600">
        <span id="procedure-count">{machines.length}</span> procédures disponibles
        <a href={getUrl('workflows')} id="clear-filter-link" class="ml-2 text-purple-600 hover:text-purple-700 hidden">
          (voir tous)
        </a>
      </p>
    </div>

    <!-- Search and Filter -->
    <div class="mb-8 bg-white rounded-lg border border-gray-200 p-4">
      <!-- Search Input -->
      <div class="mb-4">
        <div class="relative">
          <input
            type="text"
            id="workflow-search"
            placeholder="Rechercher une procédure (ex: logement, pension, CPAS...)"
            class="w-full px-4 py-3 pl-10 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
          />
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <p class="mt-2 text-xs text-gray-500">
          Tapez pour filtrer par nom ou description
        </p>
      </div>

      <div class="flex items-center justify-between mb-4">
        <h2 class="font-semibold text-gray-900">Filtrer par catégorie</h2>
        <button id="clear-category-filter" class="text-sm text-purple-600 hover:text-purple-700 hidden">
          Effacer le filtre
        </button>
      </div>
      <div id="category-filters" class="flex flex-wrap gap-2">
        <button
          data-category=""
          class="category-btn px-4 py-2 rounded-lg transition-colors bg-purple-100 text-purple-700 border-2 border-purple-500"
        >
          Tous ({machines.length})
        </button>
        {categories.map((cat: string) => (
          <button
            data-category={cat}
            class="category-btn px-4 py-2 rounded-lg transition-colors bg-gray-100 text-gray-700 border-2 border-transparent hover:border-gray-300"
          >
            {cat.charAt(0).toUpperCase() + cat.slice(1)} ({categoryCounts[cat]})
          </button>
        ))}
      </div>
    </div>

    <!-- Workflows by Category -->
    {Object.entries(machinesByCategory).map(([category, categoryMachines]: [string, any]) => (
      <div class="mb-12 category-section" data-category={category}>
        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
          <span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-lg mr-3">
            {category.charAt(0).toUpperCase() + category.slice(1)}
          </span>
          <span class="text-sm font-normal text-gray-500">
            {categoryMachines.length} procédure{categoryMachines.length > 1 ? 's' : ''}
          </span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 workflow-grid">
          {categoryMachines.map((machine: any) => (
            <a
              href={getUrl(`workflows/${machine.id}`)}
              class="workflow-card bg-white rounded-lg border border-gray-200 p-6 hover:border-purple-500 hover:shadow-lg transition-all"
              data-name={machine.name.toLowerCase()}
              data-description={(machine.description || machine.plainLanguage || '').toLowerCase()}
              data-keywords={(machine.keywords || []).join(' ').toLowerCase()}
              data-category={machine.category}
            >
              <h3 class="text-lg font-semibold text-gray-900 mb-2">{machine.name}</h3>
              <p class="text-gray-600 text-sm mb-4">
                {machine.description || machine.plainLanguage || 'Procédure administrative belge'}
              </p>

              <div class="flex items-center justify-between text-sm">
                <div class="flex items-center gap-4 text-gray-500">
                  <span title="Nombre d'étapes dans cette procédure">{machine.states?.length || 0} étapes</span>
                  <span title="Nombre d'actions possibles">{machine.events?.length || 0} actions</span>
                </div>
                <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>

              {machine.keywords && machine.keywords.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1">
                  {machine.keywords.slice(0, 3).map((keyword: string) => (
                    <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs">
                      {keyword}
                    </span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      </div>
    ))}

    <!-- Quick Actions -->
    <div class="mt-12 bg-gradient-to-r from-purple-500 to-purple-700 rounded-xl p-8 text-center text-white">
      <h2 class="text-3xl font-bold mb-4">Besoin d'Aide Pour Choisir?</h2>
      <p class="mb-6 max-w-2xl mx-auto">
        Utilisez notre assistant intelligent ou notre outil de comparaison pour trouver la procédure qui correspond à vos besoins.
      </p>
      <div class="flex justify-center gap-4">
        <a href={getUrl('wizard')} class="inline-block px-8 py-3 bg-white text-purple-600 font-semibold rounded-lg hover:bg-gray-100 transition-colors">
          Assistant de Recherche
        </a>
        <a href={getUrl('comparison')} class="inline-block px-8 py-3 bg-purple-600 text-white font-semibold rounded-lg hover:bg-purple-800 transition-colors">
          Comparer des Procédures
        </a>
      </div>
    </div>
  </div>

  <!-- Search and category filtering script -->
  <script>
    const searchInput = document.getElementById('workflow-search') as HTMLInputElement;
    const workflowCards = document.querySelectorAll('.workflow-card');
    const categorySections = document.querySelectorAll('.category-section');
    const categoryButtons = document.querySelectorAll('.category-btn');
    const clearCategoryBtn = document.getElementById('clear-category-filter');
    const clearFilterLink = document.getElementById('clear-filter-link');
    const pageTitle = document.getElementById('page-title');
    const procedureCount = document.getElementById('procedure-count');

    let currentCategory = '';
    let debounceTimer: ReturnType<typeof setTimeout>;

    // Get category from URL on page load
    function initFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const categoryParam = params.get('category');
      if (categoryParam) {
        currentCategory = categoryParam;
        applyFilters();
        updateCategoryButtonStyles();
      }
    }

    // Apply both search and category filters
    function applyFilters() {
      const query = searchInput?.value.toLowerCase().trim() || '';
      let visibleCount = 0;

      workflowCards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const description = card.getAttribute('data-description') || '';
        const keywords = card.getAttribute('data-keywords') || '';
        const category = card.getAttribute('data-category') || '';

        const matchesSearch = query === '' ||
          name.includes(query) ||
          description.includes(query) ||
          keywords.includes(query);

        const matchesCategory = currentCategory === '' || category === currentCategory;

        if (matchesSearch && matchesCategory) {
          (card as HTMLElement).style.display = '';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      // Hide category sections with no visible cards
      categorySections.forEach((section) => {
        const sectionCategory = section.getAttribute('data-category') || '';
        const visibleCards = section.querySelectorAll('.workflow-card:not([style*="display: none"])');

        // Hide section if no visible cards, or if filtering by a different category
        if (visibleCards.length === 0 || (currentCategory !== '' && sectionCategory !== currentCategory)) {
          (section as HTMLElement).style.display = 'none';
        } else {
          (section as HTMLElement).style.display = '';
        }
      });

      // Update count and title
      if (procedureCount) {
        procedureCount.textContent = String(visibleCount);
      }

      if (pageTitle) {
        if (currentCategory) {
          pageTitle.textContent = `Procédures: ${currentCategory.charAt(0).toUpperCase() + currentCategory.slice(1)}`;
        } else {
          pageTitle.textContent = 'Toutes les Procédures';
        }
      }

      // Show/hide clear filter buttons
      if (clearCategoryBtn) {
        clearCategoryBtn.classList.toggle('hidden', currentCategory === '');
      }
      if (clearFilterLink) {
        clearFilterLink.classList.toggle('hidden', currentCategory === '');
      }

      // Update search helper text
      const helperText = searchInput?.parentElement?.nextElementSibling;
      if (helperText && query !== '') {
        helperText.textContent = `${visibleCount} procédure${visibleCount !== 1 ? 's' : ''} trouvée${visibleCount !== 1 ? 's' : ''}`;
      } else if (helperText) {
        helperText.textContent = 'Tapez pour filtrer par nom ou description';
      }
    }

    // Update button styles to show active category
    function updateCategoryButtonStyles() {
      categoryButtons.forEach((btn) => {
        const btnCategory = btn.getAttribute('data-category') || '';
        if (btnCategory === currentCategory) {
          btn.classList.remove('bg-gray-100', 'text-gray-700', 'border-transparent');
          btn.classList.add('bg-purple-100', 'text-purple-700', 'border-purple-500');
        } else {
          btn.classList.remove('bg-purple-100', 'text-purple-700', 'border-purple-500');
          btn.classList.add('bg-gray-100', 'text-gray-700', 'border-transparent');
        }
      });
    }

    // Category button click handlers
    categoryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category') || '';

        // Update URL without reload
        const url = new URL(window.location.href);
        if (currentCategory) {
          url.searchParams.set('category', currentCategory);
        } else {
          url.searchParams.delete('category');
        }
        window.history.pushState({}, '', url.toString());

        applyFilters();
        updateCategoryButtonStyles();
      });
    });

    // Clear category filter
    if (clearCategoryBtn) {
      clearCategoryBtn.addEventListener('click', () => {
        currentCategory = '';
        const url = new URL(window.location.href);
        url.searchParams.delete('category');
        window.history.pushState({}, '', url.toString());
        applyFilters();
        updateCategoryButtonStyles();
      });
    }

    // Search input with debounce
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(applyFilters, 150);
      });

      // Clear search on Escape
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          searchInput.value = '';
          applyFilters();
        }
      });
    }

    // Handle browser back/forward
    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(window.location.search);
      currentCategory = params.get('category') || '';
      applyFilters();
      updateCategoryButtonStyles();
    });

    // Initialize on page load
    initFromUrl();
  </script>
</MainLayout>