---
import MainLayout from '../../layouts/Layout.astro';
import { loadMachinesMetadata } from '../../lib/machines';
import { getRelatedFeatures, getRelatedRules } from '../../lib/cross-references';
import { getUrl } from '../../lib/utils';

// This function generates all the static paths for each workflow
export async function getStaticPaths() {
  const metadata = await loadMachinesMetadata();

  return metadata.machines.map((machine: any) => ({
    params: { id: machine.id },
    props: { machine, allMachines: metadata.machines }
  }));
}

const { machine, allMachines } = Astro.props;

// Find related workflows (same category)
const relatedWorkflows = allMachines
  .filter((m: any) => m.category === machine.category && m.id !== machine.id)
  .slice(0, 3);

// Get related features and rules using cross-references
const relatedFeatures = await getRelatedFeatures(machine.id);
const relatedRules = await getRelatedRules(machine.id);
---

<MainLayout
  title={`${machine.name} - Workflow PAA`}
  description={machine.description || `Documentation du workflow ${machine.name} dans le système PAA belge`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="mb-8">
      <ol class="flex items-center space-x-2 text-sm text-gray-500">
        <li><a href={getUrl('')} class="hover:text-gray-700">Accueil</a></li>
        <li>/</li>
        <li><a href={getUrl('workflows')} class="hover:text-gray-700">Workflows</a></li>
        <li>/</li>
        <li class="text-gray-900">{machine.name}</li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-start justify-between">
        <div>
          <h1 class="text-4xl font-bold text-gray-900 mb-4">{machine.name}</h1>
          <p class="text-lg text-gray-600 mb-4">
            {machine.description || 'Workflow administratif dans le système PAA belge'}
          </p>
          <div class="flex items-center gap-4">
            <span class="inline-block px-4 py-2 bg-purple-100 text-purple-700 text-sm font-medium rounded-full">
              {machine.category}
            </span>
            {machine.complexity && (
              <span class={`inline-block px-4 py-2 text-sm font-medium rounded-full ${
                machine.complexity === 'Simple' ? 'bg-green-100 text-green-700' :
                machine.complexity === 'Medium' ? 'bg-yellow-100 text-yellow-700' :
                'bg-red-100 text-red-700'
              }`}>
                {machine.complexity}
              </span>
            )}
          </div>
        </div>
        <div class="flex gap-3">
          <button onclick="window.print()" class="px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
            Imprimer
          </button>
          <a href={`/comparison?workflows=${machine.id}`} class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700">
            Comparer
          </a>
        </div>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <div class="text-3xl font-bold text-gray-900">{machine.states?.length || 0}</div>
        <div class="text-gray-600">États</div>
      </div>
      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <div class="text-3xl font-bold text-gray-900">{machine.events?.length || 0}</div>
        <div class="text-gray-600">Événements</div>
      </div>
      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <div class="text-3xl font-bold text-gray-900">{machine.initial || 'N/A'}</div>
        <div class="text-gray-600">État Initial</div>
      </div>
    </div>

    <!-- Content Tabs -->
    <div class="bg-white rounded-lg border border-gray-200 mb-12">
      <div class="border-b border-gray-200">
        <nav class="flex space-x-8 px-6" aria-label="Tabs">
          <a href="#states" class="py-4 px-1 border-b-2 border-purple-500 font-medium text-sm text-purple-600">
            États
          </a>
          <a href="#events" class="py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300">
            Événements
          </a>
          <a href="#flow" class="py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300">
            Flux
          </a>
        </nav>
      </div>

      <!-- States Section -->
      <div id="states" class="p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">États du Workflow</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {machine.states?.map((state: string, index: number) => (
            <div class="flex items-center p-4 bg-gray-50 rounded-lg">
              <div class="flex-shrink-0 w-10 h-10 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center font-semibold">
                {index + 1}
              </div>
              <div class="ml-4">
                <div class="text-gray-900 font-medium">{state}</div>
                {state === machine.initial && (
                  <div class="text-xs text-purple-600 mt-1">État initial</div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Events Section -->
      <div id="events" class="p-6 hidden">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Événements</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {machine.events?.map((event: string) => (
            <div class="flex items-center p-4 bg-gray-50 rounded-lg">
              <svg class="w-5 h-5 text-blue-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              <span class="text-gray-900">{event}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Flow Section -->
      <div id="flow" class="p-6 hidden">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Diagramme de Flux</h2>
        <div class="bg-gray-100 rounded-lg p-8 text-center">
          <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          <p class="text-gray-500">Visualisation interactive disponible avec React islands</p>
        </div>
      </div>
    </div>

    <!-- Plain Language Section -->
    {machine.plainLanguage && (
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-12">
        <h2 class="text-xl font-semibold text-gray-900 mb-3 flex items-center">
          <svg class="w-5 h-5 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Langage Clair
        </h2>
        <p class="text-gray-700">{machine.plainLanguage}</p>
      </div>
    )}

    <!-- Keywords -->
    {machine.keywords && machine.keywords.length > 0 && (
      <div class="mb-12">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Mots-clés</h2>
        <div class="flex flex-wrap gap-2">
          {machine.keywords.map((keyword: string) => (
            <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">
              {keyword}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Related Workflows -->
    {relatedWorkflows.length > 0 && (
      <div class="mb-12">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">
          <span class="inline-flex items-center">
            <svg class="w-5 h-5 text-purple-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            Workflows Connexes
          </span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedWorkflows.map((related: any) => (
            <a href={getUrl(`workflows/${related.id}`)} class="bg-white rounded-lg border border-gray-200 p-6 hover:border-purple-500 hover:shadow-lg transition-all">
              <h3 class="font-semibold text-gray-900 mb-2">{related.name}</h3>
              <p class="text-gray-600 text-sm mb-3">{related.description || 'Workflow administratif'}</p>
              <div class="flex items-center text-sm text-gray-500">
                <span class="mr-3">{related.states?.length || 0} états</span>
                <span>{related.events?.length || 0} événements</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Related Features -->
    {relatedFeatures.length > 0 && (
      <div class="mb-12">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">
          <span class="inline-flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            Spécifications Gherkin Liées
          </span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedFeatures.slice(0, 4).map((feature: any) => (
            <a href={getUrl(`features/${feature.id}`)} class="bg-white rounded-lg border border-gray-200 p-6 hover:border-green-500 hover:shadow-lg transition-all">
              <div class="flex items-start justify-between mb-3">
                <h3 class="font-semibold text-gray-900">{feature.name}</h3>
                <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-medium rounded">
                  Feature
                </span>
              </div>
              <p class="text-gray-600 text-sm mb-3">
                {feature.description || 'Spécification métier'}
              </p>
              <div class="flex items-center text-sm text-gray-500">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
                Score: {feature.matchScore}
              </div>
              {feature.matchReasons && (
                <div class="mt-2 text-xs text-gray-400">
                  {feature.matchReasons.slice(0, 2).join(' • ')}
                </div>
              )}
            </a>
          ))}
        </div>
        {relatedFeatures.length > 4 && (
          <div class="mt-4 text-center">
            <a href={getUrl('features')} class="text-sm text-green-600 hover:text-green-700">
              Voir toutes les spécifications →
            </a>
          </div>
        )}
      </div>
    )}

    <!-- Related Rules -->
    {relatedRules.length > 0 && (
      <div class="mb-12">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">
          <span class="inline-flex items-center">
            <svg class="w-5 h-5 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
            </svg>
            Règles Métier Associées
          </span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedRules.slice(0, 4).map((rule: any) => (
            <a href={getUrl(`rules/${rule.id}`)} class="bg-white rounded-lg border border-gray-200 p-6 hover:border-blue-500 hover:shadow-lg transition-all">
              <div class="flex items-start justify-between mb-3">
                <h3 class="font-semibold text-gray-900">{rule.name}</h3>
                <span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-medium rounded">
                  Règle
                </span>
              </div>
              <p class="text-gray-600 text-sm mb-3">
                {rule.description || 'Règle de gestion'}
              </p>
              <div class="flex items-center text-sm text-gray-500">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                Score: {rule.matchScore}
              </div>
              {rule.matchReasons && (
                <div class="mt-2 text-xs text-gray-400">
                  {rule.matchReasons.slice(0, 2).join(' • ')}
                </div>
              )}
            </a>
          ))}
        </div>
        {relatedRules.length > 4 && (
          <div class="mt-4 text-center">
            <a href={getUrl('rules')} class="text-sm text-blue-600 hover:text-blue-700">
              Voir toutes les règles →
            </a>
          </div>
        )}
      </div>
    )}
  </div>

  <script>
    // Simple tab switching
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('nav a[href^="#"]');
      const sections = document.querySelectorAll('#states, #events, #flow');

      tabs.forEach(tab => {
        tab.addEventListener('click', (e) => {
          e.preventDefault();

          // Update active tab
          tabs.forEach(t => {
            t.classList.remove('border-purple-500', 'text-purple-600');
            t.classList.add('border-transparent', 'text-gray-500');
          });
          tab.classList.remove('border-transparent', 'text-gray-500');
          tab.classList.add('border-purple-500', 'text-purple-600');

          // Show corresponding section
          const targetId = tab.getAttribute('href').substring(1);
          sections.forEach(section => {
            if (section.id === targetId) {
              section.classList.remove('hidden');
            } else {
              section.classList.add('hidden');
            }
          });
        });
      });
    });
  </script>
</MainLayout>