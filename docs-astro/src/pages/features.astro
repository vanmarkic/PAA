---
import MainLayout from '../layouts/Layout.astro';
import { loadFeaturesMetadata } from '../lib/features';
import { getUrl } from '../lib/utils';

// Load features data at build time
const metadata = await loadFeaturesMetadata();
const features = metadata.features || [];
const stats = metadata.statistics || {
  total: features.length,
  totalScenarios: 0,
  totalSteps: 0,
  totalExamples: 0
};

// Create categories map with counts
const categories: Record<string, any> = {};
metadata.categories?.forEach(cat => {
  categories[cat] = {
    name: cat.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
    count: features.filter(f => f.category === cat).length,
    features: features.filter(f => f.category === cat).map(f => f.id)
  };
});

// Category icons mapping
const categoryIcons: Record<string, string> = {
  benefits: 'users',
  conversion: 'arrows-right-left',
  'droits-civils': 'scale',
  tax: 'calculator',
  immobilier: 'home',
  etrangers: 'globe',
  copropriete: 'building',
  democratie: 'hand-raised',
  ecologie: 'leaf',
  'cour-europeenne': 'flag',
  'propriete-intellectuelle': 'light-bulb',
  'recours-etat': 'shield-check',
  'statut-artiste': 'paint-brush'
};

// Featured features (hand-picked important ones)
const featuredFeatures = features
  .filter(f => f.category === 'benefits' || f.category === 'tax')
  .slice(0, 3);
---

<MainLayout title="Fonctionnalités Gherkin - PAA" description="Spécifications comportementales BDD pour le système PAA">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Spécifications Gherkin</h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Documentation comportementale des règles d'éligibilité et processus administratifs belges,
        écrite en langage naturel pour une compréhension universelle.
      </p>
      <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg max-w-2xl mx-auto">
        <p class="text-blue-800">
          <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Les spécifications Gherkin sont maintenant intégrées directement dans les pages de règles pour une meilleure cohérence.
        </p>
      </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
      <div class="bg-gradient-to-br from-purple-500 to-purple-700 rounded-lg p-6 text-white">
        <div class="text-3xl font-bold mb-2">{metadata.totalFeatures}</div>
        <div class="text-purple-100">Fonctionnalités</div>
      </div>
      <div class="bg-gradient-to-br from-blue-500 to-blue-700 rounded-lg p-6 text-white">
        <div class="text-3xl font-bold mb-2">{Object.keys(categories).length}</div>
        <div class="text-blue-100">Catégories</div>
      </div>
      <div class="bg-gradient-to-br from-green-500 to-green-700 rounded-lg p-6 text-white">
        <div class="text-3xl font-bold mb-2">{metadata.statistics?.totalScenarios || 0}</div>
        <div class="text-green-100">Scénarios</div>
      </div>
      <div class="bg-gradient-to-br from-orange-500 to-orange-700 rounded-lg p-6 text-white">
        <div class="text-3xl font-bold mb-2">FR/NL</div>
        <div class="text-orange-100">Multilingue</div>
      </div>
    </div>

    <!-- Search and Filter -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-12">
      <div class="flex flex-col md:flex-row gap-4">
        <div class="flex-1">
          <label for="search" class="block text-sm font-medium text-gray-700 mb-2">
            Rechercher une fonctionnalité
          </label>
          <input
            type="text"
            id="search"
            name="search"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
            placeholder="Rechercher par nom, scénario ou mot-clé..."
          />
        </div>
        <div class="md:w-64">
          <label for="category-filter" class="block text-sm font-medium text-gray-700 mb-2">
            Filtrer par catégorie
          </label>
          <select
            id="category-filter"
            name="category"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
          >
            <option value="">Toutes les catégories</option>
            {Object.entries(categories).map(([key, cat]) => (
              <option value={key}>{cat.name} ({cat.count})</option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <!-- Featured Features -->
    {featuredFeatures.length > 0 && (
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Fonctionnalités Principales</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {featuredFeatures.map((feature) => (
            <div class="bg-white rounded-lg border-2 border-purple-200 p-6 hover:shadow-lg transition-shadow">
              <h3 class="text-lg font-semibold text-gray-900 mb-2">{feature.name}</h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                {feature.description || 'Spécification comportementale BDD'}
              </p>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-block px-3 py-1 bg-purple-100 text-purple-700 text-xs font-medium rounded-full">
                  {categories[feature.category]?.name}
                </span>
                <span class="text-sm text-gray-500">
                  {feature.scenarios.length} scénarios
                </span>
              </div>
              <a
                href={getUrl(`features/${feature.id}`)}
                class="block text-center px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700 transition-colors"
              >
                Voir dans la règle →
              </a>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Categories Grid -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Catégories de Fonctionnalités</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {Object.entries(categories).map(([key, category]) => (
          <a
            href={getUrl(`features/category/${key}`)}
            class="bg-white rounded-lg border border-gray-200 p-6 hover:border-purple-500 hover:shadow-lg transition-all group"
          >
            <div class="flex items-start mb-4">
              <div class="flex-shrink-0 w-12 h-12 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center group-hover:bg-purple-600 group-hover:text-white transition-colors">
                {categoryIcons[key] === 'users' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                  </svg>
                )}
                {categoryIcons[key] === 'calculator' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                  </svg>
                )}
                {categoryIcons[key] === 'home' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                  </svg>
                )}
                {categoryIcons[key] === 'scale' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path>
                  </svg>
                )}
                {(!categoryIcons[key] || !['users', 'calculator', 'home', 'scale'].includes(categoryIcons[key])) && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                )}
              </div>
              <div class="ml-4 flex-1">
                <h3 class="text-lg font-semibold text-gray-900 mb-1 group-hover:text-purple-600 transition-colors">
                  {category.name}
                </h3>
                <p class="text-purple-600 font-medium">{category.count} fonctionnalités</p>
              </div>
            </div>
            <div class="space-y-1">
              {features
                .filter(f => f.category === key)
                .slice(0, 3)
                .map((feature) => (
                  <div class="text-sm text-gray-600 truncate">→ {feature.name}</div>
                ))}
              {category.count > 3 && (
                <div class="text-sm font-medium text-purple-600 mt-2">
                  Voir toutes les {category.count} fonctionnalités →
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- All Features Table -->
    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-xl font-semibold text-gray-900">Toutes les Fonctionnalités</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Nom
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Catégorie
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Scénarios
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Version
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200" id="features-table">
            {features.map((feature) => (
              <tr class="hover:bg-gray-50 feature-row" data-category={feature.category} data-name={feature.name.toLowerCase()}>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900">{feature.name}</div>
                  {feature.tags.length > 0 && (
                    <div class="text-xs text-gray-500 mt-1">
                      {feature.tags.join(' ')}
                    </div>
                  )}
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                    {categories[feature.category]?.name}
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  {feature.scenarios.length}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  {feature.version || 'N/A'}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <a href={getUrl(`features/${feature.id}`)} class="text-purple-600 hover:text-purple-900">
                    Voir dans règle →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Help Section -->
    <div class="mt-12 bg-gradient-to-r from-purple-500 to-blue-600 rounded-xl p-8 text-white">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold mb-4">Qu'est-ce que Gherkin?</h2>
        <p class="mb-6 text-purple-100">
          Gherkin est un langage de spécification comportementale qui permet de décrire le comportement
          d'un système en langage naturel. Chaque fonctionnalité est décrite à travers des scénarios
          concrets avec des étapes Given-When-Then, facilitant la communication entre les équipes
          techniques et métier.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href={getUrl('developer')} class="inline-block px-6 py-3 bg-white text-purple-600 font-semibold rounded-lg hover:bg-purple-50 transition-colors">
            Guide du Développeur
          </a>
          <a href="https://cucumber.io/docs/gherkin/" target="_blank" class="inline-block px-6 py-3 bg-purple-600 text-white font-semibold rounded-lg hover:bg-purple-700 transition-colors">
            Documentation Gherkin
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Client-side search and filter functionality
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('search') as HTMLInputElement;
      const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
      const featureRows = document.querySelectorAll('.feature-row');

      function filterFeatures() {
        const searchTerm = searchInput.value.toLowerCase();
        const selectedCategory = categoryFilter.value;

        featureRows.forEach((row) => {
          const htmlRow = row as HTMLTableRowElement;
          const name = htmlRow.dataset.name || '';
          const category = htmlRow.dataset.category || '';

          const matchesSearch = !searchTerm || name.includes(searchTerm);
          const matchesCategory = !selectedCategory || category === selectedCategory;

          htmlRow.style.display = matchesSearch && matchesCategory ? '' : 'none';
        });
      }

      searchInput?.addEventListener('input', filterFeatures);
      categoryFilter?.addEventListener('change', filterFeatures);
    });
  </script>
</MainLayout>