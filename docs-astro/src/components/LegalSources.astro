---
/**
 * Component to display legal sources for a machine/rule/feature
 * Sources are now embedded in individual JSON files
 */

interface Props {
  machineId?: string;
  ruleId?: string;
  featureId?: string;
  title?: string;
  legalSources?: any; // Can be passed directly if already loaded
}

const { machineId, ruleId, featureId, title = "Sources Légales", legalSources: passedSources } = Astro.props;

// Load legal sources from individual file if not passed
let sourcesData: any[] = [];
let metadata: any = null;

if (passedSources) {
  // Use passed sources
  sourcesData = passedSources.sources || [];
  metadata = {
    extractionDate: passedSources.extractionDate,
    lastLegislativeUpdate: passedSources.lastLegislativeUpdate,
    version: passedSources.version,
  };
} else {
  // Try to load from individual file
  const id = machineId || ruleId || featureId;
  const type = machineId ? 'machines' : ruleId ? 'rules' : 'features';
  
  if (id) {
    try {
      const itemData = await import(`../../public/${type}/${id}.json`);
      const item = itemData.default || itemData;
      
      if (item.legalSources) {
        sourcesData = item.legalSources.sources || [];
        metadata = {
          extractionDate: item.legalSources.extractionDate,
          lastLegislativeUpdate: item.legalSources.lastLegislativeUpdate,
          version: item.legalSources.version,
        };
      }
    } catch (error) {
      // Item file might not exist yet
    }
  }
}

const hasSources = sourcesData && sourcesData.length > 0;
---

{hasSources && (
  <div class="legal-sources-section bg-white rounded-lg border border-gray-200 p-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
      <svg class="w-5 h-5 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      {title}
    </h3>

    <div class="space-y-4">
      {sourcesData.map((source, index) => (
        <div class="border-l-4 border-blue-500 pl-4 py-2">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h4 class="font-medium text-gray-900 mb-1">
                {source.title}
              </h4>
              <div class="text-sm text-gray-600 space-y-1">
                {source.authority && (
                  <div>
                    <span class="font-medium">Autorité:</span> {source.authority}
                    {source.authorityType && (
                      <span class="ml-2 px-2 py-0.5 bg-gray-100 text-gray-700 rounded text-xs">
                        {source.authorityType}
                      </span>
                    )}
                  </div>
                )}
                {source.region && (
                  <div>
                    <span class="font-medium">Région:</span> {source.region}
                  </div>
                )}
                {source.publicationDate && (
                  <div>
                    <span class="font-medium">Publication:</span> {new Date(source.publicationDate).toLocaleDateString('fr-BE')}
                  </div>
                )}
                {source.effectiveDate && (
                  <div>
                    <span class="font-medium">Entrée en vigueur:</span> {new Date(source.effectiveDate).toLocaleDateString('fr-BE')}
                  </div>
                )}
                {source.language && (
                  <div>
                    <span class="font-medium">Langue:</span> {source.language.toUpperCase()}
                  </div>
                )}
              </div>
            </div>
            {source.officialUrl && (
              <a
                href={source.officialUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="ml-4 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors flex items-center text-sm font-medium"
              >
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
                Voir la source
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    {metadata && (
      <div class="mt-6 pt-4 border-t border-gray-200">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm text-gray-600">
          {metadata.extractionDate && (
            <div>
              <span class="font-medium">Date d'extraction:</span>
              <div>{new Date(metadata.extractionDate).toLocaleDateString('fr-BE')}</div>
            </div>
          )}
          {metadata.lastLegislativeUpdate && (
            <div>
              <span class="font-medium">Dernière mise à jour:</span>
              <div>{new Date(metadata.lastLegislativeUpdate).toLocaleDateString('fr-BE')}</div>
            </div>
          )}
          {metadata.version && (
            <div>
              <span class="font-medium">Version:</span>
              <div class="font-mono">{metadata.version}</div>
            </div>
          )}
        </div>
      </div>
    )}
  </div>
)}

{!hasSources && (
  <div class="legal-sources-section bg-gray-50 rounded-lg border border-gray-200 p-6">
    <p class="text-gray-500 text-sm italic">
      Aucune source légale enregistrée pour cette machine.
    </p>
  </div>
)}

<style>
  .legal-sources-section {
    margin-top: 1.5rem;
  }
</style>

