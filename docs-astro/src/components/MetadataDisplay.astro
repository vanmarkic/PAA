---
import { getUrl } from '../lib/utils';

export interface Props {
  entityType: 'procedure' | 'rule' | 'feature';
  entityId: string;
  metadata?: any;
  relatedEntities?: {
    procedures?: any[];
    rules?: any[];
    features?: any[];
    parentProcedures?: any[];
    childProcedures?: any[];
    siblingProcedures?: any[];
  };
  legalMetadata?: any;
  dataFreshness?: {
    status: 'current' | 'needs-review' | 'outdated' | 'unknown';
    label: string;
    color: string;
    daysOld: number;
  };
}

const {
  entityType,
  entityId,
  metadata = {},
  relatedEntities = {},
  legalMetadata,
  dataFreshness
} = Astro.props;

// Helper to format dates
function formatDate(date: string | Date): string {
  if (!date) return 'Non disponible';
  const d = typeof date === 'string' ? new Date(date) : date;
  return d.toLocaleDateString('fr-BE', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// Get badge color classes based on status
function getBadgeClasses(status: string): string {
  switch (status) {
    case 'current':
      return 'bg-green-100 text-green-800 border-green-200';
    case 'needs-review':
      return 'bg-orange-100 text-orange-800 border-orange-200';
    case 'outdated':
      return 'bg-red-100 text-red-800 border-red-200';
    case 'unknown':
      return 'bg-gray-100 text-gray-800 border-gray-200';
    default:
      return 'bg-gray-100 text-gray-800 border-gray-200';
  }
}

// Get icon for entity type
function getEntityIcon(type: string): string {
  switch (type) {
    case 'procedure':
      return 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2';
    case 'rule':
      return 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01';
    case 'feature':
      return 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z';
    default:
      return 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z';
  }
}

// Format authority name
function formatAuthority(authority: string): string {
  const authorityMap: Record<string, string> = {
    'federal': 'Gouvernement Fédéral',
    'wallonia': 'Région Wallonne',
    'flanders': 'Région Flamande',
    'brussels': 'Région de Bruxelles-Capitale',
    'german-community': 'Communauté Germanophone',
    'french-community': 'Communauté Française',
    'flemish-community': 'Communauté Flamande'
  };
  return authorityMap[authority] || authority;
}

// Get color for entity type
function getEntityColor(type: string): string {
  switch (type) {
    case 'procedure':
      return 'purple';
    case 'rule':
      return 'blue';
    case 'feature':
      return 'green';
    default:
      return 'gray';
  }
}
---

<div class="metadata-display space-y-6">
  <!-- Data Freshness Badge -->
  {dataFreshness && (
    <div class="flex items-center justify-between p-4 bg-white rounded-lg border-2" class:list={[getBadgeClasses(dataFreshness.status)]}>
      <div class="flex items-center space-x-3">
        <!-- Status Icon -->
        <div class="flex-shrink-0">
          {dataFreshness.status === 'current' && (
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
            </svg>
          )}
          {dataFreshness.status === 'needs-review' && (
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
            </svg>
          )}
          {dataFreshness.status === 'outdated' && (
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
            </svg>
          )}
          {dataFreshness.status === 'unknown' && (
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z"/>
            </svg>
          )}
        </div>

        <!-- Status Text -->
        <div>
          <div class="font-semibold">{dataFreshness.label}</div>
          <div class="text-sm opacity-75">Dernière vérification il y a {dataFreshness.daysOld} jours</div>
        </div>
      </div>

      <!-- Refresh Button -->
      <button
        class="px-3 py-1 text-sm font-medium bg-white bg-opacity-50 rounded-lg hover:bg-opacity-75 transition-all"
        onclick="alert('Fonctionnalité de rafraîchissement à venir')"
      >
        Vérifier maintenant
      </button>
    </div>
  )}

  <!-- Main Metadata Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Basic Information Card -->
    <div class="bg-white rounded-lg border border-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
        <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Informations Générales
      </h3>

      <dl class="space-y-3">
        <div>
          <dt class="text-sm font-medium text-gray-500">Identifiant</dt>
          <dd class="mt-1 text-sm text-gray-900 font-mono bg-gray-50 px-2 py-1 rounded">{entityId}</dd>
        </div>

        {metadata.category && (
          <div>
            <dt class="text-sm font-medium text-gray-500">Catégorie</dt>
            <dd class="mt-1">
              <a
                href={getUrl(`${entityType}s?category=${metadata.category}`)}
                class="inline-flex items-center px-3 py-1 text-sm bg-purple-100 text-purple-700 rounded-full hover:bg-purple-200 transition-colors"
              >
                {metadata.category}
                <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            </dd>
          </div>
        )}

        {metadata.version && (
          <div>
            <dt class="text-sm font-medium text-gray-500">Version</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <span class="font-semibold">{metadata.version}</span>
              {metadata.versionHistory && metadata.versionHistory.length > 1 && (
                <button
                  class="ml-2 text-purple-600 hover:text-purple-700 text-xs"
                  onclick="document.getElementById('version-timeline').scrollIntoView({behavior: 'smooth'})"
                >
                  Voir l'historique ({metadata.versionHistory.length} versions)
                </button>
              )}
            </dd>
          </div>
        )}

        {metadata.lastUpdated && (
          <div>
            <dt class="text-sm font-medium text-gray-500">Dernière mise à jour</dt>
            <dd class="mt-1 text-sm text-gray-900">{formatDate(metadata.lastUpdated)}</dd>
          </div>
        )}
      </dl>
    </div>

    <!-- Legal Sources Card -->
    {legalMetadata && legalMetadata.currentVersion && legalMetadata.currentVersion.sources && (
      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
          <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
          Sources Légales
        </h3>

        <div class="space-y-3">
          {legalMetadata.currentVersion.sources.map((source: any) => (
            <div class="p-3 bg-gray-50 rounded-lg">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <a
                    href={source.officialUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-purple-600 hover:text-purple-700 hover:underline flex items-center"
                  >
                    {source.title}
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                  </a>
                  <div class="mt-1 text-xs text-gray-600 space-y-1">
                    <div>{formatAuthority(source.authority)} • {source.region}</div>
                    <div>Publié: {formatDate(source.publicationDate)}</div>
                    {source.effectiveDate && (
                      <div>En vigueur: {formatDate(source.effectiveDate)}</div>
                    )}
                    {source.referenceNumber && (
                      <div class="font-mono text-xs bg-white px-2 py-1 rounded mt-1 inline-block">
                        Réf: {source.referenceNumber}
                      </div>
                    )}
                  </div>
                </div>
                {source.backupUrl && (
                  <a
                    href={source.backupUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ml-2 p-1 text-gray-400 hover:text-gray-600"
                    title="Lien de secours"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Lineage Section -->
  {(relatedEntities.parentProcedures?.length > 0 ||
    relatedEntities.childProcedures?.length > 0 ||
    relatedEntities.siblingProcedures?.length > 0) && (
    <div class="bg-white rounded-lg border border-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
        <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        Hiérarchie & Relations
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Parent Procedures -->
        {relatedEntities.parentProcedures?.length > 0 && (
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3 flex items-center">
              <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
              </svg>
              Procédures Parentes
            </h4>
            <div class="space-y-2">
              {relatedEntities.parentProcedures.map((proc: any) => (
                <a
                  href={getUrl(`workflows/${proc.id}`)}
                  class="block p-3 bg-purple-50 rounded-lg hover:bg-purple-100 transition-colors"
                >
                  <div class="font-medium text-purple-700">{proc.name}</div>
                  {proc.description && (
                    <div class="text-xs text-purple-600 mt-1">{proc.description}</div>
                  )}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Child Procedures -->
        {relatedEntities.childProcedures?.length > 0 && (
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3 flex items-center">
              <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
              </svg>
              Procédures Enfants
            </h4>
            <div class="space-y-2">
              {relatedEntities.childProcedures.map((proc: any) => (
                <a
                  href={getUrl(`workflows/${proc.id}`)}
                  class="block p-3 bg-purple-50 rounded-lg hover:bg-purple-100 transition-colors"
                >
                  <div class="font-medium text-purple-700">{proc.name}</div>
                  {proc.description && (
                    <div class="text-xs text-purple-600 mt-1">{proc.description}</div>
                  )}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Sibling Procedures -->
        {relatedEntities.siblingProcedures?.length > 0 && (
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3 flex items-center">
              <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
              </svg>
              Procédures Similaires
            </h4>
            <div class="space-y-2">
              {relatedEntities.siblingProcedures.slice(0, 3).map((proc: any) => (
                <a
                  href={getUrl(`workflows/${proc.id}`)}
                  class="block p-3 bg-purple-50 rounded-lg hover:bg-purple-100 transition-colors"
                >
                  <div class="font-medium text-purple-700">{proc.name}</div>
                  {proc.description && (
                    <div class="text-xs text-purple-600 mt-1">{proc.description}</div>
                  )}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Related Entities Grid -->
  {(relatedEntities.procedures?.length > 0 ||
    relatedEntities.rules?.length > 0 ||
    relatedEntities.features?.length > 0) && (
    <div class="bg-white rounded-lg border border-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
        <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
        </svg>
        Entités Liées
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Related Procedures -->
        {relatedEntities.procedures?.length > 0 && (
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3">Procédures ({relatedEntities.procedures.length})</h4>
            <div class="space-y-2">
              {relatedEntities.procedures.slice(0, 5).map((proc: any) => (
                <a
                  href={getUrl(`workflows/${proc.id}`)}
                  class="flex items-center p-2 bg-gray-50 rounded-lg hover:bg-purple-50 transition-colors group"
                >
                  <svg class="w-4 h-4 mr-2 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getEntityIcon('procedure')}/>
                  </svg>
                  <span class="text-sm text-gray-700 group-hover:text-purple-700">{proc.name}</span>
                  {proc.matchScore && (
                    <span class="ml-auto text-xs text-gray-400">{proc.matchScore}%</span>
                  )}
                </a>
              ))}
              {relatedEntities.procedures.length > 5 && (
                <a
                  href={getUrl('workflows')}
                  class="text-xs text-purple-600 hover:text-purple-700 mt-2 inline-block"
                >
                  Voir {relatedEntities.procedures.length - 5} de plus →
                </a>
              )}
            </div>
          </div>
        )}

        <!-- Related Rules -->
        {relatedEntities.rules?.length > 0 && (
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3">Règles ({relatedEntities.rules.length})</h4>
            <div class="space-y-2">
              {relatedEntities.rules.slice(0, 5).map((rule: any) => (
                <a
                  href={getUrl(`rules/${rule.id}`)}
                  class="flex items-center p-2 bg-gray-50 rounded-lg hover:bg-blue-50 transition-colors group"
                >
                  <svg class="w-4 h-4 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getEntityIcon('rule')}/>
                  </svg>
                  <span class="text-sm text-gray-700 group-hover:text-blue-700">{rule.description || rule.id}</span>
                  {rule.matchScore && (
                    <span class="ml-auto text-xs text-gray-400">{rule.matchScore}%</span>
                  )}
                </a>
              ))}
              {relatedEntities.rules.length > 5 && (
                <a
                  href={getUrl('rules')}
                  class="text-xs text-blue-600 hover:text-blue-700 mt-2 inline-block"
                >
                  Voir {relatedEntities.rules.length - 5} de plus →
                </a>
              )}
            </div>
          </div>
        )}

        <!-- Related Features -->
        {relatedEntities.features?.length > 0 && (
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3">Spécifications ({relatedEntities.features.length})</h4>
            <div class="space-y-2">
              {relatedEntities.features.slice(0, 5).map((feature: any) => (
                <a
                  href={getUrl(`features/${feature.id}`)}
                  class="flex items-center p-2 bg-gray-50 rounded-lg hover:bg-green-50 transition-colors group"
                >
                  <svg class="w-4 h-4 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getEntityIcon('feature')}/>
                  </svg>
                  <span class="text-sm text-gray-700 group-hover:text-green-700">{feature.name}</span>
                  {feature.matchScore && (
                    <span class="ml-auto text-xs text-gray-400">{feature.matchScore}%</span>
                  )}
                </a>
              ))}
              {relatedEntities.features.length > 5 && (
                <a
                  href={getUrl('features')}
                  class="text-xs text-green-600 hover:text-green-700 mt-2 inline-block"
                >
                  Voir {relatedEntities.features.length - 5} de plus →
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Version Timeline (if multiple versions) -->
  {metadata.versionHistory && metadata.versionHistory.length > 1 && (
    <div id="version-timeline" class="bg-white rounded-lg border border-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
        <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Historique des Versions
      </h3>

      <div class="relative">
        <div class="absolute left-8 top-8 bottom-0 w-0.5 bg-gray-200"></div>
        <div class="space-y-6">
          {metadata.versionHistory.map((version: any, index: number) => (
            <div class="relative flex items-start">
              <div class={`z-10 flex items-center justify-center w-16 h-16 rounded-full ${
                index === 0 ? 'bg-purple-600 text-white' : 'bg-white border-2 border-gray-300 text-gray-500'
              }`}>
                <span class="font-semibold">{version.version}</span>
              </div>
              <div class="ml-6 flex-1">
                <div class="p-4 bg-gray-50 rounded-lg">
                  <div class="flex items-center justify-between mb-2">
                    <h4 class="font-medium text-gray-900">
                      Version {version.version}
                      {index === 0 && (
                        <span class="ml-2 px-2 py-1 text-xs bg-purple-100 text-purple-700 rounded">Actuelle</span>
                      )}
                    </h4>
                    <span class="text-sm text-gray-500">{formatDate(version.extractionDate)}</span>
                  </div>
                  {version.changeLog && (
                    <p class="text-sm text-gray-600 mb-2">{version.changeLog}</p>
                  )}
                  <div class="flex items-center space-x-4 text-xs text-gray-500">
                    <span>Statut: {version.status}</span>
                    {version.lastLegislativeUpdate && (
                      <span>Mise à jour législative: {formatDate(version.lastLegislativeUpdate)}</span>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- Audit Information -->
  {(legalMetadata?.lastLegalValidation || metadata.auditInfo) && (
    <div class="bg-white rounded-lg border border-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
        <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Audit & Validation
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {legalMetadata?.lastLegalValidation && (
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3">Validation Juridique</h4>
            <dl class="space-y-2">
              <div>
                <dt class="text-xs font-medium text-gray-500">Date de validation</dt>
                <dd class="mt-1 text-sm text-gray-900">{formatDate(legalMetadata.lastLegalValidation.date)}</dd>
              </div>
              <div>
                <dt class="text-xs font-medium text-gray-500">Validateur</dt>
                <dd class="mt-1 text-sm text-gray-900">{legalMetadata.lastLegalValidation.validatorName}</dd>
              </div>
              <div>
                <dt class="text-xs font-medium text-gray-500">Rôle</dt>
                <dd class="mt-1 text-sm text-gray-900">{legalMetadata.lastLegalValidation.validatorRole}</dd>
              </div>
            </dl>
          </div>
        )}

        {metadata.auditInfo && (
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3">Informations d'Audit</h4>
            <dl class="space-y-2">
              {metadata.auditInfo.lastChecked && (
                <div>
                  <dt class="text-xs font-medium text-gray-500">Dernière vérification</dt>
                  <dd class="mt-1 text-sm text-gray-900">{formatDate(metadata.auditInfo.lastChecked)}</dd>
                </div>
              )}
              {metadata.auditInfo.checkedBy && (
                <div>
                  <dt class="text-xs font-medium text-gray-500">Vérifié par</dt>
                  <dd class="mt-1 text-sm text-gray-900">{metadata.auditInfo.checkedBy}</dd>
                </div>
              )}
              {metadata.auditInfo.status && (
                <div>
                  <dt class="text-xs font-medium text-gray-500">Statut</dt>
                  <dd class="mt-1 text-sm text-gray-900">{metadata.auditInfo.status}</dd>
                </div>
              )}
            </dl>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Contact Information -->
  {(legalMetadata?.contactEmail || legalMetadata?.contactPhone) && (
    <div class="bg-white rounded-lg border border-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
        <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        Contact
      </h3>

      <div class="flex flex-wrap gap-4">
        {legalMetadata.contactEmail && (
          <a
            href={`mailto:${legalMetadata.contactEmail}`}
            class="flex items-center px-4 py-2 bg-purple-50 text-purple-700 rounded-lg hover:bg-purple-100 transition-colors"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            {legalMetadata.contactEmail}
          </a>
        )}

        {legalMetadata.contactPhone && (
          <a
            href={`tel:${legalMetadata.contactPhone}`}
            class="flex items-center px-4 py-2 bg-purple-50 text-purple-700 rounded-lg hover:bg-purple-100 transition-colors"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            {legalMetadata.contactPhone}
          </a>
        )}
      </div>
    </div>
  )}

  <!-- Export Actions -->
  <div class="flex justify-end space-x-3">
    <button
      onclick="window.print()"
      class="px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors flex items-center"
    >
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
      </svg>
      Imprimer
    </button>

    <button
      onclick={`
        const metadata = ${JSON.stringify({entityId, entityType, metadata, legalMetadata, relatedEntities})};
        const blob = new Blob([JSON.stringify(metadata, null, 2)], {type: 'application/json'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'metadata-${entityId}.json';
        a.click();
      `}
      class="px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors flex items-center"
    >
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
      </svg>
      Exporter JSON
    </button>
  </div>
</div>

<style>
  .metadata-display {
    @apply print:text-black;
  }

  @media print {
    .metadata-display button {
      @apply hidden;
    }
  }
</style>