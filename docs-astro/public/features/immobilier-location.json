      "name": "Calcul de l'indexation annuelle du loyer",
      "description": "",
      "tags": [],
      "steps": [
        {
          "keyword": "Étant donné que",
          "text": "le loyer initial est de 750€"
        },
        {
          "keyword": "Et que",
          "text": "le bail a commencé en janvier 2022"
        },
        {
          "keyword": "Et que",
          "text": "l'indice de base est 115.53"
        },
        {
          "keyword": "Et que",
          "text": "l'indice actuel est 123.47"
        },
        {
          "keyword": "Quand",
          "text": "je calcule l'indexation pour 2024"
        },
        {
          "keyword": "Alors",
          "text": "la formule est: loyer_base × indice_nouveau / indice_base"
        },
        {
          "keyword": "Et",
          "text": "le nouveau loyer est: 750 × 123.47 / 115.53 = 801.60€"
        },
        {
          "keyword": "Et",
          "text": "l'indexation doit être notifiée par écrit"
        },
        {
          "keyword": "Et",
          "text": "elle ne peut être rétroactive que de 3 mois maximum"
        }
