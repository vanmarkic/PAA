        {
          "keyword": "Then",
          "text": "elle devrait fixer des mesures générales précises"
        },
        {
          "keyword": "And",
          "text": "établir un calendrier de mise en œuvre (18 mois)"
        },
        {
          "keyword": "And",
          "text": "suspendre l'examen des affaires similaires"
        },
        {
          "keyword": "And",
          "text": "prévoir un mécanisme de réparation domestique"
        }
