        },
        {
          "keyword": "Then",
          "text": "elle devrait identifier le problème systémique"
        },
        {
          "keyword": "And",
          "text": "sélectionner une ou plusieurs affaires pilotes"
        },
        {
          "keyword": "And",
          "text": "communiquer avec le gouvernement"
        },
        {
          "keyword": "And",
          "text": "envisager la procédure de l'arrêt pilote"
        }
