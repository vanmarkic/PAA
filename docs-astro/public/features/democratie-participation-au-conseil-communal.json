        },
        {
          "keyword": "When",
          "text": "je soumets mes observations"
        },
        {
          "keyword": "And",
          "text": "que j'inclus des propositions alternatives"
        },
        {
          "keyword": "And",
          "text": "que je joins des documents techniques"
        },
        {
          "keyword": "Then",
          "text": "ma contribution devrait être enregistrée"
        },
        {
          "keyword": "And",
          "text": "elle devrait être analysée par les services communaux"
        },
        {
          "keyword": "And",
          "text": "une réponse motivée devrait être fournie"
        },
        {
          "keyword": "And",
          "text": "le rapport final devrait mentionner ma contribution"
        }
      ],
      "isOutline": false
