      "name": "Demande d'interpellation citoyenne",
      "tags": [],
      "steps": [
        {
          "keyword": "Given",
          "text": "que je suis résident de Namur depuis 2 ans"
        },
        {
          "keyword": "And",
          "text": "que j'ai 25 ans"
        },
        {
          "keyword": "And",
          "text": "que je veux interpeller le conseil sur \"La sécurité routière\""
        },
        {
          "keyword": "When",
          "text": "je soumets ma demande d'interpellation"
        },
        {
          "keyword": "And",
          "text": "que je fournis un texte de maximum 3000 caractères"
        },
        {
          "keyword": "And",
          "text": "que je respecte le délai de 7 jours avant la séance"
        },
        {
          "keyword": "Then",
          "text": "ma demande devrait être examinée par le bureau"
        },
        {
          "keyword": "And",
          "text": "si acceptée, je devrais recevoir une invitation"
        },
        {
          "keyword": "And",
          "text": "je devrais avoir 10 minutes de temps de parole"
        },
        {
          "keyword": "And",
          "text": "le collège devrait répondre pendant la séance"
        }
      ],
      "isOutline": false
    },
    {
