{
  "name": "paa-poc",
  "version": "1.0.0",
  "description": "POC for Plateforme d'Aide Administrative - Business Logic Encoding",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node",
    "start": "node dist/api/server.js",
    "dev:api": "ts-node src/api/server.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "example:agr": "ts-node src/examples/agrExample.ts",
    "example:ris": "ts-node src/examples/risExample.ts",
    "example:ris:workflow": "ts-node src/examples/risWorkflowSimple.ts",
    "example:conversion": "ts-node src/examples/conversionExample.ts",
    "docs:generate": "ts-node scripts/generateVisualizationDocs.ts",
    "docs:metadata": "ts-node scripts/generateMachinesMetadata.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:visualization": "jest visualization/",
    "cucumber": "cucumber-js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": ["legal-tech", "civic-tech", "belgium", "business-rules", "xstate", "gherkin"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.10.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^25.0.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.3",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.2",
    "json-rules-engine": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "winston": "^3.17.0",
    "xstate": "^5.24.0",
    "zod": "^4.1.12"
  }
}
